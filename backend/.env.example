PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/mobileuse?appName=Cluster0
GEMINI_API_KEY=<your-gemini-api-key>
# Separate key/project for Agent 2 — keeps its quota independent of Agent 1's.
GEMINI_API_KEY_AGENT2=<a-different-gemini-api-key-from-a-different-project>

# Agent 2 decision model: gemini (default) or mai_ui (local MAI-UI server, see
# mai-ui-test/server.py). With mai_ui, failures fall back to Gemini unless
# MAI_UI_FALLBACK=none.
AGENT_BACKEND=gemini
MAI_UI_BASE_URL=http://127.0.0.1:8080
MAI_UI_TIMEOUT_MS=60000
MAI_UI_FALLBACK=gemini

# Two-agent mode: "two_agent" = Qwen3.5-9B checks the last step, remembers data and plans
# each step (it sees the screenshot); MAI-UI-2B grounds taps that aren't directly
# tappable by label. Both stay loaded on the model server (MAI_UI_MODEL / QWEN_MODEL are
# set there). "single" = MAI-UI alone, the old path.
AGENT_MODE=two_agent
# Step cap for two-agent runs (cross-app tasks need ~20 steps). Single mode stays at 15.
MAX_STEPS_TWO_AGENT=30
# Screen counts as loaded when this share of labels repeats across two captures.
SETTLE_SIMILARITY=0.9
SETTLE_MAX_WAITS=4

# Gmail (read-only, Dashboard -> API and the Decision Layer's Email method). The Google OAuth
# client ID/secret are read from details.txt ("Client ID : ..." / "Client Secret : ...") unless
# set here. Sign in once on the Mac: http://localhost:4000/api/gmail/connect
# GOOGLE_CLIENT_ID=<optional, overrides details.txt>
# GOOGLE_CLIENT_SECRET=<optional, overrides details.txt>
# GOOGLE_DETAILS_FILE=<path to details.txt, default ../details.txt>
# GMAIL_REDIRECT_URI=http://localhost:4000/api/gmail/oauth/callback
# GMAIL_MAX_EMAILS=50
